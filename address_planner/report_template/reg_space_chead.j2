{% for ss in space.sorted_subspace_list %}
//==========================================================
// Definition of reg {{ss.module_name_until_regbank.upper()}}
//==========================================================
#ifndef ADDR_{{ss.module_name_until_regbank.upper()}}
{% if ss.bit > 32 %}
    typedef union{
        struct {
            {%- set index = namespace(value=0) -%}
            {% for field in ss.filled_field_list -%}
                {% if field.name == 'FilledField' %}
                uint64_t reserved_{{index.value}}: {{field.bit}};
                {%- set index.value = index.value + 1 -%}
                {% else %}
                uint64_t {{field.name}}: {{field.bit}};
                {%- endif -%}
            {% endfor -%}
    } bits;
        uint64_t val;
    } {{ss.module_name_until_regbank.upper()}};
{% else %}
    typedef union{
        struct {
            {%- set index = namespace(value=0) -%}
            {% for field in ss.filled_field_list -%}
                {% if field.name == 'FilledField' %}
                uint32_t reserved_{{index.value}}: {{field.bit}};
                {%- set index.value = index.value + 1 -%}
                {% else %}
                uint32_t {{field.name}}: {{field.bit}};
                {%- endif -%}
            {% endfor -%}
    } bits;
        uint32_t val;
    } {{ss.module_name_until_regbank.upper()}};
{% endif %}
    #define {{ '%-40s' % '%s_SIZE' % ss.module_name_until_regbank.upper()}} {{builtins.hex((ss.bit/8)|int)}}
    #define {{ '%-40s' % '%s_OFFSET'  % ss.module_name_until_regbank.upper()}} {{builtins.hex((ss.offset/8)|int)}}
    #define {{ '%-40s' % '%s_RST_VAL' % ss.module_name_until_regbank.upper()}} {{builtins.hex((ss.init_value)|int)}}

#endif
{% for field in ss.sorted_field_list %}
#ifndef OFFSET_{{field.module_name_until_regbank.upper()}}
    #define OFFSET_{{field.module_name_until_regbank.upper()}}
    #define {{field.module_name_until_regbank.upper()}}_OFFSET  {{field.bit_offset}}
    #define {{field.module_name_until_regbank.upper()}}_WIDTH   {{field.bit}}
    #define {{field.module_name_until_regbank.upper()}}_MASK    {{field.mask}}
    #define {{field.module_name_until_regbank.upper()}}_RST_VAL {{field.init_value}}
#endif
{% endfor %}
{% endfor %}
